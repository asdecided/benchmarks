# Copy to .env and fill in the provider you bring (BYOK). `.env` is gitignored.
#
# The harness passes these through to the reference agent (Proofkeeper) via its
# published environment contract. Any OpenAI-compatible provider works; token
# metering is done by the harness proxy regardless of provider.

# Any OpenAI-compatible provider (OpenRouter, Groq, Together, Ollama, vLLM, ...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ...or the built-in Claude adapter (needs the optional @anthropic-ai/sdk peer
# installed in workspace/):
# ANTHROPIC_API_KEY=
